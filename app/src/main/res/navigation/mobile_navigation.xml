<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_list_chats">

    <fragment
        android:id="@+id/nav_chat"
        android:name="com.example.ai_assistant.ui.home.ChatFragment"
        android:label="Some chat"
        tools:layout="@layout/fragment_new_chat">
        <argument
            android:name="chatID"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/nav_list_chats"
        android:name="com.example.ai_assistant.ui.gallery.ChatListFragment"
        android:label="List of chats"
        tools:layout="@layout/fragment_list_chats">
    <action
        android:id="@+id/action_chatListFragment_to_chatFragment"
        app:destination="@id/nav_chat" />
    </fragment>

    <fragment
        android:id="@+id/nav_slideshow"
        android:name="com.example.ai_assistant.ui.slideshow.SlideshowFragment"
        android:label="@string/menu_slideshow"
        tools:layout="@layout/fragment_slideshow" />
</navigation>