<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mobile_navigation"
    app:startDestination="@+id/nav_slideshow">

    <fragment
        android:id="@+id/nav_chat"
        android:name="com.example.ai_assistant.ui.home.ChatFragment"
        android:label="Some chat"
        tools:layout="@layout/fragment_new_chat">
        <argument
            android:name="chatID"
            app:argType="long" />
    </fragment>

    <fragment
        android:id="@+id/nav_slideshow"
        android:name="com.example.ai_assistant.ui.slideshow.SlideshowFragment"
        android:label="@string/menu_slideshow"
        tools:layout="@layout/fragment_slideshow" />

    <activity
        android:id="@+id/mainActivity"
        android:name="com.example.ai_assistant.MainActivity"
        android:label="app_bar_main"
        tools:layout="@layout/app_bar_main" />
</navigation>